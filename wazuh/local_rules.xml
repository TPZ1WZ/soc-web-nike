<!-- ⚠️ LAB SOC — Rule phát hiện tấn công từ log NiceShop.
     Nối vào: /var/ossec/etc/rules/local_rules.xml trên Wazuh MANAGER, rồi restart wazuh-manager. -->

<group name="niceshop,web_attack,">

  <!-- Rule gốc: mọi sự kiện SECURITY được decode -->
  <rule id="100100" level="3">
    <decoded_as>niceshop-security</decoded_as>
    <description>NiceShop: security event $(event) from $(srcip)</description>
  </rule>

  <!-- SQL Injection -->
  <rule id="100110" level="10">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^SQLI_</field>
    <description>SQL Injection attempt on $(url) from $(srcip)</description>
    <mitre><id>T1190</id></mitre>
    <group>sql_injection,</group>
  </rule>
  <rule id="100111" level="13">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^SQLI_LOGIN_SUCCESS$</field>
    <description>SQLi AUTH BYPASS thành công (login) from $(srcip)</description>
    <mitre><id>T1190</id><id>T1078</id></mitre>
    <group>sql_injection,authentication_success,</group>
  </rule>

  <!-- Brute force -->
  <rule id="100120" level="5">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^LOGIN_FAILED$</field>
    <description>Đăng nhập thất bại: user $(user) from $(srcip)</description>
    <group>authentication_failed,</group>
  </rule>
  <rule id="100121" level="12" frequency="5" timeframe="60">
    <if_matched_sid>100120</if_matched_sid>
    <same_source_ip />
    <description>BRUTE FORCE: nhiều lần đăng nhập thất bại từ $(srcip)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,</group>
  </rule>

  <!-- Broken Access Control -->
  <rule id="100130" level="10">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^BROKEN_ACCESS$</field>
    <description>Broken Access Control: $(url) truy cập bởi $(srcip)</description>
    <mitre><id>T1078</id></mitre>
    <group>privilege_escalation,</group>
  </rule>

  <!-- File upload / webshell -->
  <rule id="100140" level="12">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^FILE_UPLOAD_SUSPICIOUS$</field>
    <description>Upload file nguy hiểm (webshell?): $(filename) from $(srcip)</description>
    <mitre><id>T1505.003</id></mitre>
    <group>web_shell,</group>
  </rule>
  <!-- Path traversal: tên file chứa ../ -->
  <rule id="100141" level="12">
    <if_sid>100100</if_sid>
    <field name="filename" type="pcre2">\.\./|\.\.\\</field>
    <description>PATH TRAVERSAL qua upload: $(filename) from $(srcip)</description>
    <mitre><id>T1083</id></mitre>
    <group>path_traversal,</group>
  </rule>

  <!-- Stored XSS -->
  <rule id="100150" level="10">
    <if_sid>100100</if_sid>
    <field name="event" type="pcre2">^XSS_STORED$</field>
    <description>Stored XSS payload lưu bởi $(srcip)</description>
    <mitre><id>T1059.007</id></mitre>
    <group>xss,</group>
  </rule>

  <!-- ===== TƯƠNG QUAN: chiến dịch tấn công đa giai đoạn (Multi-stage) ===== -->
  <!-- Fires khi >=6 alert web_attack từ CÙNG 1 IP trong 180s = 1 campaign -->
  <rule id="100200" level="15" frequency="6" timeframe="180">
    <if_matched_group>web_attack</if_matched_group>
    <same_source_ip />
    <description>MULTI-STAGE WEB ATTACK: chiến dịch tấn công đa giai đoạn từ $(srcip) (nhiều loại tấn công web liên tiếp)</description>
    <mitre><id>T1190</id><id>T1078</id><id>T1505.003</id></mitre>
    <group>attack_campaign,web_attack,</group>
  </rule>

</group>
