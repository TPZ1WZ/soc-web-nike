# ================= AI Investigation Assistant - cấu hình =================
# Copy file này thành .env rồi điền giá trị:  cp .env.example .env

# --- LLM (mặc định OpenAI) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...            # <== ĐIỀN API KEY OpenAI của bạn
OPENAI_MODEL=gpt-4o-mini         # rẻ + đủ tốt; có thể đổi gpt-4o
# Nếu dùng Ollama (local, OpenAI-compatible): đặt như dưới, KHÔNG cần key
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1

# --- Kết nối Wazuh Indexer (để KÉO alert tự động) ---
WAZUH_INDEXER_URL=https://100.60.73.243:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASS=SecretPassword

# --- (tùy chọn) gửi cảnh báo Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
